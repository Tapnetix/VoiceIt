backend/tests/results/
backend/tests/fixtures/reference_voice.wav
backend/tests/fixtures/reference_voice.txt

# Coverage / test artifacts (audit-coverage tooling drops these in the
# tree; CI re-generates them on every run so they don't belong in git).
.coverage
py-cov.json
app/coverage/
app/test-results/
